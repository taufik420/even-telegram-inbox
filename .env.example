# Telegram credentials — FILL IN YOURSELF in `.env.local`, never commit it.
# Get your own pair at https://my.telegram.org (login with your phone number).
# NEVER paste these values in chat or commit them to the repo.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Bot API token (fallback backend: Channel Digest + Triage/Drafts). Optional.
TELEGRAM_BOT_TOKEN=
